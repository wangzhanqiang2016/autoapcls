spring:
  application:
    name: autoapcls
  profiles:
    active: dev
  datasource:
    jdbc-url: jdbc:h2:mem:autoapcls;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
    driver-class-name: org.h2.Driver
    username: sa
    password:
  h2:
    console:
      enabled: true
      path: /h2-console
  flyway:
    enabled: true
    locations: classpath:db/migration

# MyBatis-Plus
mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT
jwt:
  secret: <YOUR_JWT_SECRET_CHANGE_IN_PRODUCTION>
  expiration-ms: 7200000

# 文件存储
file:
  storage:
    base-path: /data/apclose/files

# 飞书 OAuth
feishu:
  app-id: <YOUR_FEISHU_APP_ID>
  app-secret: <YOUR_FEISHU_APP_SECRET>
  redirect-uri: http://localhost:3001/login/callback
  mock-enabled: false

# Oracle EBS 8010 数据源（Flyway 不管理此数据源）
ebs:
  datasource:
    jdbc-url: jdbc:oracle:thin:@<EBS_HOST>:<EBS_PORT>:<EBS_SID>
    username: <EBS_USERNAME>
    password: <EBS_PASSWORD>
    driver-class-name: oracle.jdbc.OracleDriver
    hikari:
      maximum-pool-size: 5
      minimum-idle: 1
      connection-timeout: 30000
      idle-timeout: 600000

# 服务器
server:
  port: 8080

# 日志
logging:
  level:
    com.autoapcls: DEBUG
